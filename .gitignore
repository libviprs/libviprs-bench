# Build artifacts
/target
# Cargo.lock IS tracked. `publish = false`, so the usual "libraries do not pin"
# argument does not apply, and `build.rs` digests this file into
# `provenance.lockfileHash`. Untracked, that field hashed something cargo was
# free to re-resolve on any build, in a document whose entire point is that a
# reader can check what produced it (libviprs-bench #66).

# macOS
.DS_Store
._*

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# Generated benchmark reports. Each family writes into its own report/<family>/
# subdirectory now (issue #64), so the glob has to reach a level deeper.
report/**/*.svg
report/**/*.json
report/**/*.txt
report/**/*.csv
report/**/*.md

# Generated scalability charts (copied to libviprs-org for publishing)
scalability_*.svg
scalability_*.json

# Criterion HTML reports and saved baselines
target/criterion/

# Flame graph intermediaries
perf.data
perf.data.old
*.folded
flamegraph_*.svg

# Benchmark fixtures (large files, not tracked)
fixtures/*.pdf
fixtures/*.tiff
fixtures/*.tif
fixtures/*.png
fixtures/*.jpg
fixtures/*.jpeg
fixtures/*.raw
# ...except the one small, checksum-verified real-content fixture committed for
# the rasterized-PDF scalability workload (issues #30/#31). Its provenance and
# the enforced SHA-256 live in fixtures/PROVENANCE.md.
!fixtures/cc_licenses_mapping.pdf

# Docker build context artifacts
*.tar
*.tar.gz
